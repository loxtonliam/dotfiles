layout {

    focus-ring {
        active-color   "#d77580"
        inactive-color "#231a1b"
        urgent-color   "#e81830"
    }

    border {
        active-color   "#d77580"
        inactive-color "#231a1b"
        urgent-color   "#e81830"
    }


    tab-indicator {
        active-color   "#d77580"
        inactive-color "#7b1f29"
        urgent-color   "#e81830"
    }

    insert-hint {
        color "#d7758080"
    }
}

recent-windows {
    highlight {
        active-color "#d77580"
        urgent-color "#e81830"
    }
}
